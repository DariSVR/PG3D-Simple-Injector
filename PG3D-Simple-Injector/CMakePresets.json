{
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "lhs": "${hostSystemName}",
                "rhs": "Windows",
                "type": "equals"
            }
        },
        {
            "architecture": {
                "strategy": "external",
                "value": "x64"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "displayName": "x64 Release",
            "inherits": "windows-base",
            "name": "x64-release"
        }
    ],
    "version": 3
}
